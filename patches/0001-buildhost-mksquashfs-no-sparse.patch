diff --git a/include/image.mk b/include/image.mk
index 3f5268efac..36aea5ac85 100644
--- a/include/image.mk
+++ b/include/image.mk
@@ -91,6 +91,10 @@ SQUASHFSOPT += -p '/dev d 755 0 0' -p '/dev/console c 600 0 0 5 1'
 SQUASHFSOPT += $(if $(CONFIG_SELINUX),-xattrs,-no-xattrs)
 SQUASHFSOPT += -block-readers $(CONFIG_TARGET_SQUASHFS_BLOCK_READERS)
 SQUASHFSOPT += -small-readers $(CONFIG_TARGET_SQUASHFS_SMALL_READERS)
+# This build host (WSL1) reports st_blocks=0 for small files.  mksquashfs
+# then treats them as sparse, its SEEK_DATA probe fails and it silently
+# writes them as 0-byte files -- which bricks the image (empty /etc/inittab).
+SQUASHFSOPT += -no-sparse
 SQUASHFSCOMP := gzip
 LZMA_XZ_OPTIONS := -Xpreset 9 -Xe -Xlc 0 -Xlp 2 -Xpb 2
 ifeq ($(CONFIG_SQUASHFS_XZ),y)
